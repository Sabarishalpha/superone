# Public origin for canonical metadata, sitemap, and same-origin contact checks.
NEXT_PUBLIC_SITE_URL=

# Public contact details are only shown when configured.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Three-letter ISO 4217 currency code used by the project budget selector.
# Defaults to USD when left empty.
NEXT_PUBLIC_BUDGET_CURRENCY=

# Resend email delivery. Use a verified sender address.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Required in production for distributed contact-form rate limiting.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
